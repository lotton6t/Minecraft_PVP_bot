{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "pvp:master",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "lv1": "textures/entity/pvp_master_lv1",
        "lv2": "textures/entity/pvp_master_lv2",
        "lv3": "textures/entity/pvp_master_lv3",
        "lv4": "textures/entity/pvp_master_lv4",
        "lv5": "textures/entity/pvp_master_lv5"
      },
      "geometry": {
        "default": "geometry.pvp_master"
      },
      "spawn_egg": {
        "base_color": "#98A0AC",
        "overlay_color": "#AA2020"
      },
      "scripts": {
        "initialize": [
          "variable.is_holding_right = 1.0;",
          "variable.gliding_speed_value = 1.0;",
          "variable.smooth_pitch = 0.0;",
          "variable.smooth_yaw = 0.0;"
        ],
        "pre_animation": [
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.bob_animation = query.life_time;",
          "variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
          "variable.smooth_pitch = math.lerp(variable.smooth_pitch, query.property('pvp:head_pitch'), math.clamp(query.delta_time * 5.0, 0.0, 1.0));",
          "variable.smooth_yaw = math.lerp(variable.smooth_yaw, query.property('pvp:head_yaw'), math.clamp(query.delta_time * 5.0, 0.0, 1.0));"
        ],
        "animate": [
          "humanoid_base_pose",
          "move",
          "bob",
          "holding",
          "attack_controller",
          "look_at_target"
        ]
      },
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.pvp_master.look_at_target",
        "move": "animation.humanoid.move",
        "bob": "animation.humanoid.bob",
        "holding": "animation.humanoid.holding",
        "attack_controller": "controller.animation.humanoid.attack",
        "attack.rotations": "animation.humanoid.attack.rotations"
      },
      "render_controllers": [
        "controller.render.pvp_master"
      ],
      "enable_attachables": true
    }
  }
}
