            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 128
            }
          ]
        }
      },
      "pvp:target_tag": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64.0,
          "scan_interval": 10,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "value": "pvp_target"
                  }
                ]
              },
              "max_dist": 128
            }
          ]
        }
      }
