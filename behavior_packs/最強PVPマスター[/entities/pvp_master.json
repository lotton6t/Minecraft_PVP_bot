    "events": {
      "pvp:set_level_1": {
        "set_property": {
          "pvp:skin_level": 1
        }
      },
      "pvp:set_level_2": {
        "set_property": {
          "pvp:skin_level": 2
        }
      },
      "pvp:set_level_3": {
        "set_property": {
          "pvp:skin_level": 3
        }
      },
      "pvp:set_level_4": {
        "set_property": {
          "pvp:skin_level": 4
        }
      },
      "pvp:set_level_5": {
        "set_property": {
          "pvp:skin_level": 5
        }
      },
      "pvp:set_target_all": {
        "add": {
          "component_groups": [
            "pvp:target_all"
          ]
        },
        "remove": {
          "component_groups": [
            "pvp:target_tag"
          ]
        }
      },
      "pvp:set_target_tag": {
        "add": {
          "component_groups": [
            "pvp:target_tag"
          ]
        },
        "remove": {
          "component_groups": [
            "pvp:target_all"
          ]
        }
      }
